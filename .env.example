# Скопіюй цей файл у .env та заповни значення. Секрети тримати лише тут (.env gitignored).

# Токен бота: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your_token_here

# ID сервера для модераційного cog (кікер). 0 = вимкнено автокік при on_ready.
GUILD_ID=716985574413565953

# Префікс команд
COMMAND_PREFIX=!

# --- Музика (yt-dlp) ---
# Шлях до файлу cookies.txt (експорт з браузера). Лишити порожнім якщо не треба.
COOKIES_FILE=cookies.txt
# Браузер для автоматичного забору cookies, якщо файлу немає:
# chrome / firefox / edge / brave / opera. Порожнє = вимкнено.
COOKIES_FROM_BROWSER=
# Аудіофільтр за замовчуванням: off / normalize / bassboost / treble /
# nightcore / vaporwave / 8d / earrape. normalize вирівнює гучність треків.
DEFAULT_FILTER=normalize

# --- Spotify (для !play <spotify-посилання>) ---
# ⚠️ З 11.02.2026 Spotify вимагає акаунт Premium, щоб створити застосунок і отримати
# ключі Web API (Development Mode). Безкоштовно ключ більше НЕ видають.
# Якщо маєш Premium: створи застосунок на https://developer.spotify.com/dashboard,
# увімкни "Web API", встав Client ID/Secret сюди. Код (spotify.py) запрацює одразу.
# Порожнє = Spotify вимкнено (SoundCloud/YouTube працюють без цього).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Веб-дашборд (керування з браузера) ---
# Вмикається ЛИШЕ якщо задано пароль (порожнє = вимкнено). Слухає лише localhost.
# Для доступу ззовні — через тунель/HTTPS (напр. Cloudflare Tunnel), а не 0.0.0.0 напряму.
# Якщо порт зайнятий — бот не падає, просто стартує без дашборда (лог-warning).
DASHBOARD_PASSWORD=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
